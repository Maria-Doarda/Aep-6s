# Modelo das variaveis de ambiente. Copie para .env e preencha com os valores reais.
#   Windows:     Copy-Item .env.example .env
#   Mac/Linux:   cp .env.example .env
#
# O .env fica fora do Git (veja .gitignore); este modelo e versionado.
# O Spring Boot nao le .env sozinho: ele e usado pelo Docker (--env-file)
# e pelo shell que roda o mvnw (veja docs/DEPLOY.md, secao 8).

# String de conexao do MongoDB. A URL precisa terminar com /poc_doacoes,
# senao os dados vao para o banco "test".
# Local:  mongodb://localhost:27017/poc_doacoes
# Atlas:  mongodb+srv://USUARIO:SENHA@cluster0.xxxxx.mongodb.net/poc_doacoes?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://USUARIO:SENHA@cluster0.xxxxx.mongodb.net/poc_doacoes?retryWrites=true&w=majority

# O Render injeta PORT automaticamente. Local: 8081.
PORT=8081

# prod = le MONGO_URI/PORT e desliga o Docker Compose.
# demo = cria 2 doadores e 3 doacoes quando o banco esta vazio.
SPRING_PROFILES_ACTIVE=prod,demo
